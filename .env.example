# Gateway (Jobbeacon-gateway). Mọi API đi qua gateway, không gọi thẳng service.
VITE_API_BASE_URL=http://localhost:8088
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Chỉ dùng cho trang admin: URL site người dùng (link "Xem trên trang tìm việc")
VITE_USER_SITE_URL=http://localhost:5173
# Chỉ dùng cho trang admin: URL Grafana để nhúng dashboard "Giám sát hệ thống". Rỗng = ẩn.
VITE_GRAFANA_URL=http://localhost:3001
